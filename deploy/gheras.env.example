# Gheras backend — production settings. Copied to /etc/gheras/gheras.env by
# deploy/provision.sh (root:gheras, 640). Never commit the real file.
# API keys (fal, Moyasar, SMTP...) don't go here: add them in the admin
# «المفاتيح والمزوّدين» page, where they're stored encrypted.

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=gheras_prod
# Marks a real server: rehearsal mode (GHERAS_FAKE_PROVIDERS) refuses to start here.
GHERAS_ENV=production

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# First boot only: creates the admin, who must change the password on first login.
ADMIN_EMAIL=admin@gheras.com
ADMIN_PASSWORD=CHANGE_ME

# Encrypts the keys saved in the admin page. openssl rand -hex 32 — keep a copy:
# losing it means re-entering every key.
SECRETS_ENCRYPTION_KEY=CHANGE_ME

# Where the site is reached (links in emails, Moyasar return pages).
PUBLIC_APP_URL=http://76.13.0.195:3000
CORS_ORIGINS=http://76.13.0.195:3000
# Only once the API is on HTTPS: lets Moyasar confirm payments directly.
# PUBLIC_API_URL=https://gheras.example

STORAGE_BACKEND=local
STORAGE_DIR=/var/lib/gheras/media

# Filled in by provision.sh (Playwright's Chromium, prints the picture book).
PDF_BROWSER=

MEDIA_TOKEN_HOURS=12
